# Ejemplo de archivo .env para el backend de Precios

# --- Base de datos MySQL ---
mysql_host=localhost           # Host de la base de datos MySQL
mysql_user=usuario             # Usuario de la base de datos
mysql_password=contraseña      # Contraseña de la base de datos
mysql_database=precios_db      # Nombre de la base de datos

# --- API ---
service_port_api=3000          # Puerto en el que se expone la API

# --- CORS ---
cors_origin=http://localhost:3000 # Orígenes permitidos para CORS (separados por espacio)

# --- Seguridad y claves internas ---
KEY_INT=clave_interna_secreta  # Clave interna para operaciones protegidas (importaciones, etc)

# --- Autenticación JWT (RBAC) ---
JWT_SECRET=clave_secreta_jwt_cambiar_en_produccion
JWT_EXPIRES_IN=8h

# --- SSO Greenborn (inicio de sesión con Google, app_id "precios") ---
URL_AUTH_SERVICE=https://auth.greenborn.com.ar  # URL del servicio SSO central
SSO_DEFAULT_ROL=usuario                         # Rol asignado a usuarios creados automáticamente vía SSO
ADMIN_EMAIL=lucho.2012.tandil@gmail.com         # Email del admin único (rol administrador)

# --- Servicio de Colas (Node, externo) ---
# El backend solo encola (POST /add_data). Quien procesa es el consumidor Python
# extra_services/actualizar_precios.py, que lee de a un item (GET /get_data).
QUEUE_SERVICE_URL=http://localhost:3501  # URL base del servicio de colas externo

# --- Sincronizacion de cache en memoria de la API ---
# El consumidor Python avisa a la API cada vez que escribe un price_today, para
# que el cache en memoria quede al dia sin reiniciar el servidor
internal_sync_key=clave_interna_sync    # Clave compartida para POST /interno/sync_cache
# API_BASE_URL=http://localhost         # Base de la API que recibe el sync (default http://localhost)

# --- Consumidor de la cola (extra_services/actualizar_precios.py) ---
# QUEUE_KEY=precios                     # Cola unica de la que consume
# QUEUE_POLL_INTERVAL=1                 # Segundos de espera cuando la cola esta vacia
# QUEUE_MAX_RETRY=3                     # Reintentos antes de descartar un item
# QUEUE_RETRY_BACKOFF=5                 # Segundos de pausa por fallo transitorio consecutivo
# QUEUE_RETRY_BACKOFF_MAX=60            # Tope de esa pausa
# QUEUE_BACKLOG_LOG_EVERY=100           # Cada cuantos items se loguea el backlog (0 = nunca)

# --- Otros (agregar según necesidad) ---
# mysql_port=3306              # Puerto de MySQL (si no es el default)
# NODE_ENV=development         # Entorno de ejecución (development/production) 